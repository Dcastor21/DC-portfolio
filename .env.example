# ─────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in the values.
#
#      cp .env.example .env.local
#
#  Every variable below is OPTIONAL. With none of them set, the
#  site runs in mock mode using data/mock.json — useful for a
#  first look before you commit to setting up a CMS.
# ─────────────────────────────────────────────────────────────

# ── Sanity (content) ─────────────────────────────────────────
# Create a free project at https://www.sanity.io/manage
# The project ID is the 8-character string in your project URL.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Almost always "production" unless you created a custom dataset.
NEXT_PUBLIC_SANITY_DATASET=production

# Pin the API version. Bumping this can change response shapes.
NEXT_PUBLIC_SANITY_API_VERSION=2023-05-03

# Write token — ONLY needed for `npm run seed` (importing sample
# content) and for draft previews. Generate one under
# Project → API → Tokens with Editor permissions.
# Never commit this. Never prefix it with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# ── Contact form (optional) ──────────────────────────────────
# The contact section posts here. Leave blank to render the form
# as a mailto: link instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
